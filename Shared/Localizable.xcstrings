    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Everyone in the chat needs DND Dice to see the result; others only see the formula and an install prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群里每个人都要安装 DND Dice 才能看到结果；没装的人只会看到公式和安装提示。"
          }
        }
      }
    },
    "Guidance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神导术"
          }
        }
      }
    },
    "Hex": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脆弱诅咒"
          }
        }
      }
    },
    "How to Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用说明"
          }
        }
      }
    },
    "Hunter's Mark": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "猎人印记"
          }
        }
      }
    },
    "Mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式"
          }
        }
      }
    },
    "Modifier": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加值"
          }
        }
      }
    },
    "Normal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通"
          }
        }
      }
    },
    "On: a natural 20 or 1 is a critical success or failure and decides the DC. Off: only the total is compared with the DC. Rolls you send in Messages use your setting, and the formula shows it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开：天然 20 / 1 为大成功 / 大失败，并决定 DC 成败。关：只用总值和 DC 比较。在「信息」里发出的投骰按你的设置判定，公式会标出。"
          }
        }
      }
    },
    "Once sent, the bubble shows the result, the same for everyone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点发送后，气泡上直接显示结果，大家看到的都一样"
          }
        }
      }
    },
    "One Fewer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少一个"
          }
        }
      }
    },
    "One More": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多一个"
          }
        }
      }
    },
    "Open Messages and go to a conversation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「信息」，进入一个对话"
          }
        }
      }
    },
    "Panel Tips": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板小技巧"
          }
        }
      }
    },
    "Pick your dice, then tap Roll": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选好骰子，点「投掷」"
          }
        }
      }
    },
    "Purpose (optional), e.g. Stealth": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目的（可选），如：察觉检定"
          }
        }
      }
    },
    "Recent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Roll": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投掷"
          }
        }
      }
    },
    "Roll Again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再投一次"
          }
        }
      }
    },
    "Roll in the App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 里投骰"
          }
        }
      }
    },
    "Rules": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则"
          }
        }
      }
    },
    "Set your dice and tap Roll; the roll goes into the text field": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置骰子后点「投掷」，消息会放进输入框"
          }
        }
      }
    },
    "Set your dice on this screen and tap Roll. The result shows at the top; the last 10 rolls are kept until you close the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本页设好骰子，点「投掷」，结果显示在上方；最近 10 次记录关掉 App 后清空"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Subtract": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减"
          }
        }
      }
    },
    "Tap + Bonus to add dice such as +1d4 for Bless or −1d4 for Bane; tap a bonus tag to change or remove it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「＋ 加成」可以加入祝福术的 +1d4、灾祸术的 −1d4 等加成骰；点加成标签可以增减或删除"
          }
        }
      }
    },
    "Tap + next to the text field and choose DND Dice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点输入框左侧的 +，在 App 列表里选「DND Dice」"
          }
        }
      }
    },
    "Tap the DC number to type a value up to 999": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 DC 的数字可以直接输入，最高 999"
          }
        }
      }
    },
    "The result is fixed when you tap Roll and nobody sees it before it's sent, so deleting and rolling again doesn't help.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果在点「投掷」时就已确定，发送前谁都看不到，删掉重投也不会更好。"
          }
        }
      }
    },
    "To say what the roll is for (like “attack the goblin”), type it at the top of the panel; it shows in the bubble": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在面板最上方写这次投骰的目的（如「攻击哥布林」），会显示在气泡里"
          }
        }
      }
    },
    "Turn critical success and failure on or off in Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在设置里开关大成功 / 大失败判定"
          }
        }
      }
    },
    "Use in Messages": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「信息」里使用"
          }
        }
      }
    },
    "Add or Subtract": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加或减"
          }
        }
      }
    },
    "DC %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DC %lld"
          }
        }
      }
    },
    "Double-tap to type a DC": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下输入 DC"
          }
        }
      }
    },
    "Add %lldd%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加 %lldd%lld"
          }
        }
      }
    },
    "Subtract %lldd%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减 %lldd%lld"
          }
        }
      }
    },
    "Change or remove this bonus": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改或删除这个加成"
          }
        }
      }
    },
    "%lld of %lld characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld 个字"
          }
        }
      }
    },
    "Double-tap to open the full result": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下查看完整结果"
          }
        }
      }
    },
    "Tap a sent roll to see the full result and purpose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点已发送的投骰，查看完整结果和目的"
          }
        }
      }
    }
  },
  "version": "1.0"
}
