        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空目的"
          }
        }
      }
    },
    "Couldn't insert the roll. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入失败，请重试"
