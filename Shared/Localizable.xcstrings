            "value": "优势"
          }
        }
      }
    },
    "Advantage and disadvantage need exactly one d20 as the main die": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主骰正好是 1 个 d20 时才能选优势或劣势"
          }
        }
      }
    },
